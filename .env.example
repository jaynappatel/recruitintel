# PostgreSQL used by both the Next.js server and collectors.
DATABASE_URL=postgresql://recruitintel:recruitintel@localhost:5433/recruitintel

# Use a separate database for integration tests. Tests never create/drop a database.
TEST_DATABASE_URL=postgresql://recruitintel:recruitintel@localhost:5433/recruitintel_test

# Identify this installation when accessing public provider endpoints.
RECRUITINTEL_USER_AGENT=RecruitIntel/0.1 (+https://example.com/recruitintel; contact=you@example.com)

# Optional GitHub API authentication for higher public API limits. Worker-only.
GITHUB_TOKEN=

# Required for repository attachment and sync-request mutation APIs.
# Use a long random value; this is separate from GITHUB_TOKEN.
RECRUITINTEL_ADMIN_TOKEN=

# Initial credential-free public-web search provider. Point this at a JSON object
# whose keys are exact generated queries and whose values are SearchResult arrays.
# Leave empty to register an inert `static` provider that returns no results.
PUBLIC_WEB_STATIC_RESULTS_FILE=

# Public-web fetches are HTML-only, robots-aware, and separately rate/size limited.
PUBLIC_WEB_MAX_RESPONSE_BYTES=5000000
PUBLIC_WEB_REQUESTS_PER_SECOND=1

# Collector transport defaults.
COLLECTOR_MAX_CONCURRENCY=5
COLLECTOR_REQUESTS_PER_SECOND=2
COLLECTOR_TIMEOUT_SECONDS=20
COLLECTOR_MAX_RESPONSE_BYTES=10000000

FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app

RUN python -m venv /opt/venv
COPY pyproject.toml uv.lock ./
COPY services/collectors/pyproject.toml services/collectors/pyproject.toml
COPY services/collectors services/collectors
RUN pip install --no-cache-dir uv \
  && uv sync --frozen --no-dev

FROM runtime AS collectors
WORKDIR /app/services/collectors
ENTRYPOINT ["recruitintel-collectors"]

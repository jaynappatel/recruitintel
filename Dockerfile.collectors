FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH=/app/services/collectors/src

WORKDIR /app

RUN python -m venv /opt/venv
COPY pyproject.toml uv.lock ./
COPY services/collectors/pyproject.toml services/collectors/pyproject.toml
COPY services/collectors services/collectors
RUN pip install --no-cache-dir \
  "cryptography==50.0.0" \
  "httpcore==1.0.9" \
  "httpx==0.28.1" \
  "psycopg[binary]==3.3.4" \
  "pydantic==2.13.4" \
  && pip install --no-cache-dir --no-deps -e services/collectors

FROM runtime AS collectors
WORKDIR /app/services/collectors
CMD ["python", "-m", "recruitintel_collectors", "scheduler"]
